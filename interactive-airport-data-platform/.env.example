# Provider: ollama (local) or openai (hosted). No automatic provider switching.
AIRPORT_MODEL_PROVIDER=ollama
AIRPORT_MODEL_NAME=llama3.1:8b
AIRPORT_OLLAMA_MODEL_NAME=llama3.1:8b
AIRPORT_OLLAMA_BASE_URL=http://localhost:11434

# Hosted OpenAI-compatible configuration. Keep credentials in the process environment.
AIRPORT_OPENAI_API_KEY=
AIRPORT_OPENAI_BASE_URL=
AIRPORT_OPENAI_MODEL_NAME=
AIRPORT_HOSTED_INPUT_USD_PER_MILLION=
AIRPORT_HOSTED_OUTPUT_USD_PER_MILLION=
AIRPORT_HOSTED_MAX_INPUT_TOKENS=4000
AIRPORT_HOSTED_MAX_OUTPUT_TOKENS=1000
AIRPORT_HOSTED_FREE_PLAN=false
AIRPORT_HOSTED_PRODUCT_IMPROVEMENT_TERMS=unknown
AIRPORT_HOSTED_PROVIDER_FEES_FX_MULTIPLIER=1.0
AIRPORT_HOSTED_MAX_EXTRA_FEE_USD_PER_REQUEST=
AIRPORT_HOSTED_FREE_MONTHLY_REQUEST_LIMIT=1000
AIRPORT_HOSTED_FREE_MONTHLY_TOKEN_LIMIT=1000000
AIRPORT_DEPLOYMENT_MONTHLY_BUDGET_USD=10.00
AIRPORT_DATABASE_PATH=var/airport_analytics.sqlite3
AIRPORT_SOURCE_DATA_DIR=source_data
AIRPORT_SHARED_REUSE_ENABLED=false
AIRPORT_PRODUCTION=false
# Local-only development bypass; also requires --server.address=127.0.0.1.
# Enables reuse controls for testing, but each purpose still requires session opt-in.
AIRPORT_DEV_SIGN_IN_ENABLED=false
AIRPORT_RETENTION_POLICY_APPROVED=false

# LangSmith tracing requires both explicit operator enablement and disclosure.
LANGSMITH_TRACING=false
AIRPORT_LANGSMITH_DISCLOSURE_ENABLED=false
LANGSMITH_API_KEY=
AIRPORT_LANGSMITH_MAX_TRACE_CHARGE_USD=

# Configure Streamlit OIDC in .streamlit/secrets.toml; never put real secrets here.

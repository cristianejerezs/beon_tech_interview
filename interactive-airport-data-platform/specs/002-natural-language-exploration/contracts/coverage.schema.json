{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:airport-analytics:coverage-declaration:1",
  "title": "Snapshot Coverage Declaration",
  "description": "Structural validation only. Applicability, source completeness evidence and semantic interval checks are mandatory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "declaration_id", "declaration_version", "snapshot_id",
    "declared_at", "declared_by", "calendar_basis", "origins",
    "documentation", "validation"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "declaration_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "declaration_version": {"type": "integer", "minimum": 1},
    "snapshot_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "declared_at": {"type": "string", "format": "date-time"},
    "declared_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "calendar_basis": {"const": "recorded_departure_date"},
    "origins": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/origin"}
    },
    "documentation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "sha256", "supports"],
        "properties": {
          "reference": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "supports": {"type": "string", "minLength": 1}
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validator_version", "validated_at", "reviewed_by", "checks"],
      "properties": {
        "validator_version": {"type": "string", "minLength": 1},
        "validated_at": {"type": "string", "format": "date-time"},
        "reviewed_by": {"type": "string", "minLength": 1, "maxLength": 128},
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "passed", "evidence_reference"],
            "properties": {
              "check_id": {"type": "string", "minLength": 1},
              "passed": {"type": "boolean"},
              "evidence_reference": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"}
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "covered_intervals", "gaps"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z0-9]{3,4}$"},
        "covered_intervals": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/interval"}
        },
        "gaps": {
          "type": "array",
          "items": {"$ref": "#/$defs/interval"}
        }
      }
    }
  }
}
